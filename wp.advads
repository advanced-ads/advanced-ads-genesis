{
  "wp": {
    "name": "Advanced Ads – Genesis",
    "description": "Place ads on various positions within Genesis themes",
    "version": "2.0.0",
    "requireWP": "5.7",
    "requirePHP": "7.4",
    "textDomain": "advanced-ads-genesis",
    "glotpress": "advanced-ads-genesis"
  },
  "paths": {
    "php": "includes",
    "views": "views",
    "updates": "updates",
    "javascript": "assets/src",
    "css": "assets/css"
  },
  "misc": {
    "package": "AdvancedAds\\Genesis",
    "prefix": "wp_advads_genesis",
    "constprefix": "AA_GENESIS"
  },
  "year": 2025,
  "company": {
    "name": "Advanced Ads",
    "url": "https://wpadvancedads.com/"
  },
  "author": {
    "name": "Advanced Ads",
    "email": "info@wpadvancedads.com",
    "url": "https://wpadvancedads.com/"
  },
  "package": {
    "vendor": "advanced-ads",
    "name": "advanced-ads-genesis"
  },
  "glotpress": {
    "project": "advanced-ads-genesis",
    "destination": "./languages/"
  },
  "wpPot": {
    "output": "/languages/",
    "file": "advanced-ads-genesis.pot",
    "domain": "advanced-ads-genesis"
  }
}